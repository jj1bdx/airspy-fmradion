+#ifdef __linux__
+#include <sys/resource.h>
+#endif // __linux__
+
+#include "BlockTrace.h"
+
+namespace blocktrace {
+namespace {
+
+// Ring size in records; a power of two. At about 190 records per second,
+// the writer thread may stall for about 340 seconds before records are lost.
+constexpr std::size_t ring_records = 65536;
+constexpr std::chrono::milliseconds drain_interval{200};
+constexpr int writer_nice_increment = 10;
+
+// One trace record: a decoded block ('B'), the prefill write ('P'), or an
+// adaptive prefill write ('A'). A field that does not apply is -1.
+struct Record {
+  std::int64_t t_push = -1;
+  std::int64_t t_pull = -1;
+  std::int64_t t_decode_end = -1;
+  std::int64_t t_write_start = -1;
+  std::int64_t t_write_end = -1;
+  std::int64_t cpu_pull = -1;
+  std::int64_t cpu_decode_end = -1;
+  std::int64_t queue_len = -1;
+  std::int64_t frames = -1;
+  std::int64_t pre_avail = -1;
+  std::int64_t post_avail = -1;
+  std::uint64_t block = 0;
+  std::uint64_t dropped = 0; // records lost before this one
+  char type = 'B';
+  bool underflow = false;
+};
+
+// Single-producer single-consumer ring of records. The slots are touched at
+// construction, so the producer never takes a page fault on first use.
+class Ring {
+public:
+  Ring() : m_slots(ring_records) {}
+
+  // Producer only. If the ring is full, count the record as dropped.
+  void push(Record &rec) {
+    const std::uint64_t head = m_head.load(std::memory_order_relaxed);
+    const std::uint64_t dropped = m_dropped.load(std::memory_order_relaxed);
+    if (head - m_tail.load(std::memory_order_acquire) >= ring_records) {
+      m_dropped.store(dropped + 1, std::memory_order_relaxed);
+      return;
+    }
+    rec.dropped = dropped;
+    m_slots[head % ring_records] = rec;
+    m_head.store(head + 1, std::memory_order_release);
+  }
+
+  // Consumer only. Call fn for each stored record, then free the slots.
+  template <class Fn> std::size_t drain(Fn fn) {
+    const std::uint64_t tail = m_tail.load(std::memory_order_relaxed);
+    const std::uint64_t head = m_head.load(std::memory_order_acquire);
+    for (std::uint64_t i = tail; i < head; i++) {
+      fn(m_slots[i % ring_records]);
+    }
+    m_tail.store(head, std::memory_order_release);
+    return static_cast<std::size_t>(head - tail);
+  }
+
+  std::uint64_t dropped() const {
+    return m_dropped.load(std::memory_order_relaxed);
+  }
+
+private:
+  std::vector<Record> m_slots;
+  alignas(64) std::atomic<std::uint64_t> m_head{0};
+  alignas(64) std::atomic<std::uint64_t> m_tail{0};
+  alignas(64) std::atomic<std::uint64_t> m_dropped{0};
+};
+
+// A free-frames value from PortAudio; a negative value is an error code.
+std::int64_t avail_or_unknown(std::int64_t avail) {
+  return avail >= 0 ? avail : -1;
+}
+
+// The ring, the output file, and the writer thread.
+class Tracer {
+public:
+  explicit Tracer(FILE *file, const std::string &path)
+      : m_file(file), m_path(path) {}
+
+  ~Tracer() { stop(); }
+
+  Tracer(const Tracer &) = delete;
+  Tracer &operator=(const Tracer &) = delete;
+
+  void start() {
+    m_thread = std::thread([this] { run(); });
+  }
+
+  // Join the writer thread, write the remaining records and the end line,
+  // and close the file; safe to call twice.
+  void stop() {
+    if (m_file == nullptr) {
+      return;
+    }
+    {
+      std::scoped_lock<std::mutex> lock(m_mutex);
+      m_stop = true;
+    }
+    m_cond.notify_all();
+    if (m_thread.joinable()) {
+      m_thread.join();
+    }
+    drain();
+    fmt::println(m_file, "# end_monotonic_ns={}", now_ns());
+    fmt::println(m_file, "# records_written={}", m_written);
+    fmt::println(m_file, "# records_dropped={}", ring.dropped());
+    std::fclose(m_file);
+    m_file = nullptr;
+  }
+
+  // Write a header line to the file only.
+  void header(const std::string &line) {
+    if (m_file != nullptr) {
+      fmt::println(m_file, "# {}", line);
+    }
+  }
+
+  const std::string &path() const { return m_path; }
+  std::uint64_t written() const { return m_written; }
+
+  Ring ring;
+  // Record being assembled for the current block; decode thread only.
+  Record pending;
+  bool pa_seen = false;
+
+private:
+  void run() {
+#ifdef __linux__
+    // On Linux, the nice value applies to the calling thread only.
+    const id_t tid = static_cast<id_t>(gettid());
+    setpriority(
+        PRIO_PROCESS, tid,
+        std::min(getpriority(PRIO_PROCESS, tid) + writer_nice_increment, 19));
+#endif // __linux__
+    std::unique_lock<std::mutex> lock(m_mutex);
+    while (!m_stop) {
+      m_cond.wait_for(lock, drain_interval, [this] { return m_stop; });
+      lock.unlock();
+      drain();
+      lock.lock();
+    }
+  }
+
+  // Append the stored records to the file.
+  void drain() {
+    m_line.clear();
+    const std::size_t count = ring.drain([this](const Record &r) {
+      if (m_written == 0 && m_line.empty()) {
+        m_line = "type,block,t_push_ns,t_pull_ns,t_decode_end_ns,"
+                 "t_write_start_ns,t_write_end_ns,cpu_pull_ns,"
+                 "cpu_decode_end_ns,queue_len,frames,pre_avail,post_avail,"
+                 "underflow,dropped\n";
+      }
+      fmt::format_to(std::back_inserter(m_line),
+                     "{},{},{},{},{},{},{},{},{},{},{},{},{},{},{}\n", r.type,
+                     r.block, r.t_push, r.t_pull, r.t_decode_end,
+                     r.t_write_start, r.t_write_end, r.cpu_pull,
+                     r.cpu_decode_end, r.queue_len, r.frames, r.pre_avail,
+                     r.post_avail, r.underflow ? 1 : 0, r.dropped);
+    });
+    if (count > 0) {
+      std::fwrite(m_line.data(), 1, m_line.size(), m_file);
+      std::fflush(m_file);
+      m_written += count;
+    }
+  }
+
+  FILE *m_file;
+  const std::string m_path;
+  std::uint64_t m_written = 0; // writer thread, then stop()
+  std::string m_line;
+  std::mutex m_mutex; // writer thread control only
+  std::condition_variable m_cond;
+  bool m_stop = false;
+  std::thread m_thread;
+};
+
+std::unique_ptr<Tracer> g_tracer;
+
+} // namespace
+
+bool init(int argc, char **argv, const std::string &git_info) {
+  const char *path = std::getenv("AFM_TRACE");
+  if (path == nullptr || *path == '\0') {
+    return true;
+  }
+  FILE *file = std::fopen(path, "w");
+  if (file == nullptr) {
+    fmt::println(stderr, "ERROR: AFM_TRACE: can not open '{}' ({})", path,
+                 std::strerror(errno));
+    return false;
+  }
+  g_tracer = std::make_unique<Tracer>(file, path);
+  detail::g_enabled = true;
+
+  // The mid point of two CLOCK_MONOTONIC readings pairs with CLOCK_REALTIME.
+  const std::int64_t mono_before = now_ns();
+  const std::int64_t realtime = clock_ns(CLOCK_REALTIME);
+  const std::int64_t mono_after = now_ns();
+  std::string command_line;
+  for (int i = 0; i < argc; i++) {
+    command_line.append(i == 0 ? "" : " ").append(argv[i]);
+  }
+  Tracer &t = *g_tracer;
+  t.header("airspy-fmradion block trace, format version 1");
+  t.header(fmt::format("clock_realtime_ns={}", realtime));
+  t.header(
+      fmt::format("clock_monotonic_ns={}", (mono_before + mono_after) / 2));
+  t.header(
+      fmt::format("clock_pair_uncertainty_ns={}", mono_after - mono_before));
+  t.header(fmt::format("git={}", git_info));
+  t.header(fmt::format("command_line={}", command_line));
+  t.header(fmt::format("pid={}", getpid()));
+#ifdef __linux__
+  // The caller is the decode thread (the main thread).
+  t.header(fmt::format("decode_tid={}", gettid()));
+#endif // __linux__
+  t.header(fmt::format("ring_records={}", ring_records));
+  t.header(fmt::format("drain_interval_ms={}", drain_interval.count()));
+  t.start();
+  fmt::println(stderr, "AFM_TRACE: writing block trace to '{}'", path);
+  return true;
+}
+
+void note(const std::string &line) {
+  if (enabled()) {
+    g_tracer->header(line);
+    fmt::println(stderr, "AFM_TRACE: {}", line);
+  }
+}
+
+void shutdown() {
+  if (enabled()) {
+    g_tracer->stop();
+    fmt::println(stderr, "AFM_TRACE: {} records written to '{}', {} dropped",
+                 g_tracer->written(), g_tracer->path(),
+                 g_tracer->ring.dropped());
+  }
+}
+
+namespace detail {
+
+void block_pulled(std::uint64_t block, std::int64_t t_push,
+                  std::int64_t queue_len) {
+  const std::int64_t t_pull = now_ns();
+  Tracer &t = *g_tracer;
+  t.pending = Record{};
+  t.pending.block = block;
+  t.pending.t_push = t_push;
+  t.pending.t_pull = t_pull;
+  t.pending.cpu_pull = clock_ns(CLOCK_THREAD_CPUTIME_ID);
+  t.pending.queue_len = queue_len;
+  t.pa_seen = false;
+}
+
+void before_write(std::int64_t frames) {
+  const std::int64_t t_decode_end = now_ns();
+  Record &r = g_tracer->pending;
+  r.t_decode_end = t_decode_end;
+  r.cpu_decode_end = clock_ns(CLOCK_THREAD_CPUTIME_ID);
+  // Overwritten by pa_write() for PortAudio.
+  r.t_write_start = t_decode_end;
+  r.frames = frames;
+}
+
+void after_write() {
+  Tracer &t = *g_tracer;
+  if (!t.pa_seen) {
+    t.pending.t_write_end = now_ns();
+  }
+  t.ring.push(t.pending);
+}
+
+} // namespace detail
+
+void pa_write(std::int64_t t_start, std::int64_t t_end, std::int64_t frames,
+              std::int64_t pre_avail, std::int64_t post_avail, bool underflow) {
+  if (!enabled()) {
+    return;
+  }
+  Tracer &t = *g_tracer;
+  Record &r = t.pending;
+  r.t_write_start = t_start;
+  r.t_write_end = t_end;
+  r.frames = frames;
+  r.pre_avail = avail_or_unknown(pre_avail);
+  r.post_avail = avail_or_unknown(post_avail);
+  r.underflow = underflow;
+  t.pa_seen = true;
+}
+
+void pa_silence(char kind, std::int64_t t_start, std::int64_t t_end,
+                std::int64_t frames, std::int64_t pre_avail,
+                std::int64_t post_avail, bool underflow) {
+  if (!enabled()) {
+    return;
+  }
+  Tracer &t = *g_tracer;
+  Record r;
+  r.type = kind;
+  // The block whose write caused the silence write.
+  r.block = t.pending.block;
+  r.t_write_start = t_start;
+  r.t_write_end = t_end;
+  r.frames = frames;
+  r.pre_avail = avail_or_unknown(pre_avail);
+  r.post_avail = avail_or_unknown(post_avail);
+  r.underflow = underflow;
+  t.ring.push(r);
+}
+
+} // namespace blocktrace

+// GNU General Public License for more details.
+//
+// You should have received a copy of the GNU General Public License
+// along with this program.  If not, see <https://www.gnu.org/licenses/>.
+
+#ifndef INCLUDE_BLOCKTRACE_H
+#define INCLUDE_BLOCKTRACE_H
+
+#include <cstddef>
+#include <cstdint>
+#include <ctime>
+#include <string>
+
+// Measurement-only timing trace of the decode thread, for underflow
+// measurements. It is enabled only when the environment variable AFM_TRACE
+// names an output file; otherwise each hook is one not-taken branch.
+//
+// The decode thread stores fixed-size records in a preallocated ring. A
+// separate writer thread appends them to the file as CSV. The decode thread
+// does no I/O, no allocation, and takes no lock. All timestamps are
+// CLOCK_MONOTONIC nanoseconds. The format is described in
+// doc/LINUX_UNDERFLOW_RESULTS_20261020_trace_format.md.
+
+namespace blocktrace {
+
+namespace detail {
+// Set once by init() before any other thread exists; read-only afterwards.
+inline bool g_enabled = false;
+
+void block_pulled(std::uint64_t block, std::int64_t t_push,
+                  std::int64_t queue_len);
+void before_write(std::int64_t frames);
+void after_write();
+} // namespace detail
+
+/// Return true if tracing is enabled.
+inline bool enabled() { return detail::g_enabled; }
+
+/// Return the time of a clock in nanoseconds.
+inline std::int64_t clock_ns(clockid_t clock) {
+  timespec ts;
+  clock_gettime(clock, &ts);
+  return static_cast<std::int64_t>(ts.tv_sec) * 1000000000 + ts.tv_nsec;
+}
+
+/// Return the CLOCK_MONOTONIC time in nanoseconds.
+inline std::int64_t now_ns() { return clock_ns(CLOCK_MONOTONIC); }
+
+/// Return now_ns() if tracing is enabled, or 0 if not.
+inline std::int64_t stamp() { return enabled() ? now_ns() : 0; }
+
+/// Read AFM_TRACE and, if it is set, open the trace file, write the header,
+/// and start the writer thread. Call it first in main(), on the decode
+/// thread, before any other thread is created. Return false on failure to
+/// open the file; return true if tracing is off.
+bool init(int argc, char **argv, const std::string &git_info);
+
+/// Write a one-time line to the trace header, and echo it to stderr.
+void note(const std::string &line);
+
+/// Drain the ring, write the end line, and close the file. Call it once,
+/// after the decode loop. It prints the record counts to stderr.
+void shutdown();
+
+/// Decode thread: a block was pulled from buffer. The buffer provides
+/// last_pull_push_ns() and last_pull_queue_len() (see DataBuffer).
+template <class Buffer>
+inline void block_pulled(std::uint64_t block, const Buffer &buffer) {
+  if (enabled()) {
+    detail::block_pulled(block, buffer.last_pull_push_ns(),
+                         buffer.last_pull_queue_len());
+  }
+}
+
+/// Decode thread: the decode of the block is done, and the write of frames
+/// audio frames is about to start.
+inline void before_write(std::int64_t frames) {
+  if (enabled()) {
+    detail::before_write(frames);
+  }
+}
+
+/// Decode thread: the write returned; store the record of the block.
+inline void after_write() {
+  if (enabled()) {
+    detail::after_write();
+  }
+}
+
+/// PortAudioOutput: refine the record of the block being written with the
+/// times around Pa_WriteStream() and the free frames (-1: unknown) before and
+/// after the write.
+void pa_write(std::int64_t t_start, std::int64_t t_end, std::int64_t frames,
+              std::int64_t pre_avail, std::int64_t post_avail, bool underflow);
+
+/// PortAudioOutput: store a record of a silence write; kind is 'P' for the
+/// prefill (prime) or 'A' for an adaptive prefill step.
+void pa_silence(char kind, std::int64_t t_start, std::int64_t t_end,
+                std::int64_t frames, std::int64_t pre_avail,
+                std::int64_t post_avail, bool underflow);
+
+} // namespace blocktrace
+
+#endif // INCLUDE_BLOCKTRACE_H

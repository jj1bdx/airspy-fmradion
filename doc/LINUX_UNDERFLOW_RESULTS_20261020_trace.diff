index 0000000..0b116c3
--- /dev/null
+++ b/include/BlockTrace.h
@@ -0,0 +1,118 @@
+// airspy-fmradion
+// Software decoder for FM broadcast radio with Airspy
+//
+// Copyright (C) 2015 Edouard Griffiths, F4EXB
+// Copyright (C) 2019-2026 Kenji Rikitake, JJ1BDX
+//

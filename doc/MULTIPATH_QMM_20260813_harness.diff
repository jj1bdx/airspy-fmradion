+namespace {
+
+// Read the multipath filter's warm-up wait length, in blocks, from the
+// MF_WAIT_BLOCKS environment variable. Parsed exactly once per process
+// (function-local static), so every FmDecoder constructed in a run agrees
+// even though only one instance exists in practice. Falls back to the
+// compiled-in default on a missing variable, an empty string, non-numeric
+// or trailing-garbage input, a negative value, or a value judged
+// unrealistically large; the fallback and the value actually used are both
+// reported to stderr so a run's logs record it unambiguously.
+unsigned int mf_wait_blocks_from_env() {
+  constexpr unsigned int default_wait_blocks = 20;
+  // Generous sanity cap: far beyond any realistic wait (the shipped default
+  // is 20 blocks), but small enough to reject typos/garbage reliably.
+  constexpr long max_wait_blocks = 1000000;
+  static const unsigned int wait_blocks = [default_wait_blocks] {
+    unsigned int result = default_wait_blocks;
+    const char *env = std::getenv("MF_WAIT_BLOCKS");
+    if (env != nullptr && env[0] != '\0') {
+      char *endptr = nullptr;
+      errno = 0;
+      long parsed = std::strtol(env, &endptr, 10);
+      bool valid = (endptr != env) && (*endptr == '\0') && (errno == 0) &&
+                   (parsed >= 0) && (parsed <= max_wait_blocks);
+      if (valid) {
+        result = static_cast<unsigned int>(parsed);
+      } else {
+        fmt::println(stderr,
+                     "MF_WAIT_BLOCKS: invalid value '{}', falling back to {}",
+                     env, default_wait_blocks);
+      }
+    }
+    fmt::println(stderr, "MFWAIT,{}", result);
+    return result;
+  }();
+  return wait_blocks;
+}
+
